# Delta Sales CRM — backend
#
# Copy to .env and fill in. Values here are placeholders, never real
# credentials: the real file is gitignored and stays that way.
#
# Only the three under "Required" have no working default. Everything else runs
# without being set — the feature it belongs to is simply off, which is the
# intended state for an installation not using it. The exception is R2, which
# is now required in practice: see the note there.

# ── Required ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/crm
JWT_SECRET=change-me-to-something-long-and-random
JWT_REFRESH_SECRET=change-me-to-something-else-long-and-random

# ── Where it runs ─────────────────────────────────────────────────────────────
PORT=7868
NODE_ENV=development
CLIENT_URL=http://localhost:3000
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Object storage (Cloudflare R2) ────────────────────────────────────────────
#
# Payment receipts taken when a lead is closed.
#
# Deliberately the same five values Delta Finance uses, and the same bucket. A
# receipt has to end up attached to the invoice an approver is looking at in
# that application; sharing the bucket means the handover carries a key and
# finance attaches the file this wrote — one object per receipt rather than two
# copies that can drift apart.
#
# Required in practice, not optional: a receipt is mandatory at the close, so
# without these nobody can close a lead. The upload says so plainly rather than
# losing the file, but it does block the close.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=delta-uploads
# The public base URL the bucket is served from.
R2_PUBLIC_URL=

# ── Handover to Delta Finance ─────────────────────────────────────────────────
#
# On only when every field is set. A half-configured integration is the
# dangerous state — it would queue enrolments nobody is delivering.
#
# FINANCE_CLIENT_ID and FINANCE_INTEGRATION_SECRET must match INBOUND_CLIENT_ID
# and INBOUND_INTEGRATION_SECRET on the finance side.
FINANCE_API_URL=
FINANCE_CLIENT_ID=crm
FINANCE_INTEGRATION_SECRET=
# Which organization in finance these enrolments belong to — the Dubai academy's.
FINANCE_ORG_ID=
# The Bangalore academy's organization in finance. A close for the Bangalore
# academy is billed there in INR; unset, a Bangalore close is refused.
FINANCE_ORG_ID_BANGALORE=

# ── Scheduled jobs ────────────────────────────────────────────────────────────
#
# The daily lead split, follow-up warnings, reminders and backups. On in
# exactly one process: two processes against one database assign every lead
# twice and notify everybody twice.
RUN_SCHEDULERS=true

# ── Web push notifications ────────────────────────────────────────────────────
#
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com

# ── Optional integrations ─────────────────────────────────────────────────────
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email (optional) ──────────────────────────────────────────────────────────
# The mailbox Remote CRM sends lead, idle and meeting emails from.
# Leave SMTP_HOST empty and every email is written to the log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Remote CRM <no-reply@your-domain.com>"

# ── Commission from Root (optional) ───────────────────────────────────────────
# On: who earns what on a sale and My Pay are worked out by Root from the plan it
# keeps, and Root's plan is copied into this CRM every five minutes. Off (empty):
# this CRM counts with its own plan. Root is reached the way the daily tracker is.
COMMISSION_FROM_ROOT=
ROOT_ERP_API_URL=
ROOT_ORG_SECRET=

# ── First run only ────────────────────────────────────────────────────────────
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=superadmin@your-domain.com
SUPER_ADMIN_PASSWORD=ChangeMe@123
