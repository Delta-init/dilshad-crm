# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which is the point of having one: it carries the
# variable names and what they are for, never a value.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

dist
sheets

# Telegram backup temp files
backups/

# logs
logs/
*.log

# WhatsApp: the linked devices' keys and the chats' files (env WHATSAPP_SESSION_DIR / WHATSAPP_MEDIA_DIR)
whatsapp-sessions/
whatsapp-media/
